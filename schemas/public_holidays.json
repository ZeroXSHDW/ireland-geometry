{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ireland-geometry.public-holidays.v1",
  "title": "Ireland Geometry public holiday dates",
  "description": "Explicit ISO-8601 holiday dates used to evaluate PH ferry opening-hours tokens.",
  "type": "object",
  "required": ["contract", "dates"],
  "properties": {
    "contract": {
      "const": "ireland-geometry.public-holidays.v1"
    },
    "source": {
      "type": "string"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
